{
  "name": "DISHA 8.2 — Workflow 2: Daily VPA Health Recalibration & Capacity Briefing (6 AM)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "node-schedule-6am",
      "name": "Schedule: Daily 6:00 AM IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.DISHA_API_BASE_URL || 'http://localhost:3000') + '/api/vpa/health-check' }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-vpa-admin-key",
              "value": "={{ $env.VPA_ADMIN_API_KEY }}"
            }
          ]
        }
      },
      "id": "node-http-health-recal",
      "name": "Trigger Daily Health Recalibration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        320
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.DISHA_API_BASE_URL || 'http://localhost:3000') + '/api/vpa/analytics?merchantId=mer_default' }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-vpa-admin-key",
              "value": "={{ $env.VPA_ADMIN_API_KEY }}"
            }
          ]
        }
      },
      "id": "node-http-analytics",
      "name": "Fetch Pool Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const ana = $input.first().json.analytics || {};\nconst cap = ana.capacity || {};\n\nconst dailyCr = (cap.dailySafeVolumeCapacity / 10000000).toFixed(2);\nconst monthlyCr = (cap.monthlySafeVolumeCapacity / 10000000).toFixed(2);\n\nconst bankStr = (ana.bankDiversity || []).map(b => `  • ${b.bank}: ${b.count} VPAs (${b.pct}%)`).join('\\n');\n\nconst briefing = `🌅 *DISHA 8.2 — Daily 6:00 AM Fleet Health Briefing*\\n\\n` +\n  `📊 *Fleet Status:*\\n` +\n  `• Total VPAs: ${ana.total}\\n` +\n  `• Active & Healthy: ${ana.active}\\n` +\n  `• In Cooldown/Quarantine: ${ana.cooldown}\\n` +\n  `• Flagged/Risk: ${ana.flagged}\\n` +\n  `• Fleet Average Health Score: ${ana.avgHealth} / 100\\n\\n` +\n  `🛡️ *Safe Anti-Ban Capacity:*\\n` +\n  `• Daily Safe Transactions: ${cap.dailySafeTxCapacity?.toLocaleString('en-IN')} txns/day\\n` +\n  `• Daily Safe Volume: ₹${dailyCr} Crore/day\\n` +\n  `• Monthly Safe Run-Rate: ₹${monthlyCr} Crore/month\\n\\n` +\n  `🏦 *Bank Diversity:*\\n${bankStr}\\n\\n` +\n  `⏰ *Time Slot Distribution:*\\n` +\n  `• Morning: ${ana.timeSlots?.MORNING || 0} | Afternoon: ${ana.timeSlots?.AFTERNOON || 0} | Evening: ${ana.timeSlots?.EVENING || 0}\\n\\n` +\n  `All counters reset to 0. Clean accounts awarded +2 health credit.`;\n\nreturn [{ json: { briefing, analytics: ana } }];"
      },
      "id": "node-format-briefing",
      "name": "Format Executive Briefing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ]
    },
    {
      "parameters": {
        "chatId": "@disha_treasury_alerts",
        "text": "={{ $json.briefing }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram-dispatch",
      "name": "Send Telegram / Slack Briefing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1180,
        320
      ]
    }
  ],
  "connections": {
    "Schedule: Daily 6:00 AM IST": {
      "main": [
        [
          {
            "node": "Trigger Daily Health Recalibration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Daily Health Recalibration": {
      "main": [
        [
          {
            "node": "Fetch Pool Analytics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pool Analytics": {
      "main": [
        [
          {
            "node": "Format Executive Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Executive Briefing": {
      "main": [
        [
          {
            "node": "Send Telegram / Slack Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
