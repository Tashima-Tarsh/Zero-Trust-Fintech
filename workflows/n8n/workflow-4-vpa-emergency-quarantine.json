{
  "name": "DISHA 8.2 — Workflow 4: Emergency VPA Quarantine & Auto-Failover",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alerts/bank-anomaly",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-anomaly",
      "name": "Webhook: Bank Anomaly / Failure Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 320],
      "webhookId": "disha-bank-anomaly"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/vpa/quarantine",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.DISHA_ADMIN_KEY || 'disha_live_admin_secret_key_2026' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vpaId\": \"{{ $json.body.vpaId }}\",\n  \"reason\": \"{{ $json.body.reason || 'Consecutive UPI dropoffs / Bank warning' }}\"\n}",
        "options": {}
      },
      "id": "node-http-quarantine",
      "name": "Execute 7-Day Emergency Quarantine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/vpa/select",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.DISHA_ADMIN_KEY || 'disha_live_admin_secret_key_2026' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"merchantId\": \"mer_default\",\n  \"amount\": 500\n}",
        "options": {}
      },
      "id": "node-http-replacement",
      "name": "Acquire Immediate Healthy Replacement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Webhook: Bank Anomaly / Failure Alert').first().json.body || {};\nconst quarRes = $('Execute 7-Day Emergency Quarantine').first().json;\nconst replRes = $input.first().json.selectedVpa || {};\n\nconst alertMsg = '🚨 *DISHA 8.2 EMERGENCY ANTI-BAN ACTION* 🚨\\n\\n' +\n  '• Quarantined VPA: `' + (original.vpaAddress || original.vpaId) + '`\\n' +\n  '• Reason: ' + (original.reason || 'Algorithmic Anomaly') + '\\n' +\n  '• Action Taken: Health lowered to 30. Enforced 7-day cooldown.\\n' +\n  '• Failover Activated: Traffic rerouted to `' + (replRes.vpaAddress || 'N/A') + '` (' + (replRes.bankName || 'N/A') + ')\\n' +\n  '• New Node Health: ' + (replRes.healthScore || 100) + '/100';\n\nreturn [{\n  json: {\n    quarantineStatus: quarRes.status,\n    quarantinedVpaId: quarRes.vpaId,\n    cooldownUntil: quarRes.cooldownUntil,\n    replacementVpa: replRes.vpaAddress,\n    replacementBank: replRes.bankName,\n    emergencyMessage: alertMsg\n  }\n}];"
      },
      "id": "node-emergency-format",
      "name": "Format Incident & Replacement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "chatId": "@disha_security_ops",
        "text": "={{ $json.emergencyMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-dispatch-emergency",
      "name": "Send Ops Telegram / Slack Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1180, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-alert",
      "name": "Respond to Anomaly Reporter",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 420]
    }
  ],
  "connections": {
    "Webhook: Bank Anomaly / Failure Alert": {
      "main": [
        [
          {
            "node": "Execute 7-Day Emergency Quarantine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute 7-Day Emergency Quarantine": {
      "main": [
        [
          {
            "node": "Acquire Immediate Healthy Replacement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acquire Immediate Healthy Replacement": {
      "main": [
        [
          {
            "node": "Format Incident & Replacement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Incident & Replacement": {
      "main": [
        [
          {
            "node": "Send Ops Telegram / Slack Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Respond to Anomaly Reporter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
