{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DISHA: Build frontend deployment bundles",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "windows": { "command": "npm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "DISHA: Check source syntax",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "windows": { "command": "npm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "DISHA: Test payment and SaaS contracts",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "windows": { "command": "npm.cmd" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
