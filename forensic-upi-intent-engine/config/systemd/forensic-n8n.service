[Unit]
Description=Forensic UPI Intent Engine - n8n workflow service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=forensic
Group=forensic
WorkingDirectory=/opt/forensic-upi-intent-engine
EnvironmentFile=/etc/forensic-upi-intent-engine/n8n.env
Environment=N8N_USER_FOLDER=/var/lib/forensic-n8n
ExecStart=/usr/bin/env n8n start
Restart=on-failure
RestartSec=5
StateDirectory=forensic-n8n
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
