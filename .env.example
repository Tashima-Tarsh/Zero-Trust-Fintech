# DISHA 8.2 Environment Configuration Example
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/disha82
MERCHANT_UPI_ID=disha82@ybl
MERCHANT_NAME=DISHA 8.2 Store

# Platform governance: merchants require owner approval before activation.
DISHA_INVITE_ONLY_ENABLED=true

# Clerk must be configured in your deployment with valid credentials.
# Never commit production Clerk secret keys to Git.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sole platform Super Admin: nitish@thenitishkr.in
# Access is tied to this verified primary Clerk email in platform-control.js.
# DISHA_OWNER_CLERK_USER_ID and DISHA_OWNER_EMAIL are legacy; they are ignored.
# The Super Admin can approve all merchants without requesting merchant access.

# OWNER OBSERVABILITY (read-only; names/keys are not exposed to browsers)
# Public GitHub Actions works without a key if the repository is public.
DISHA_MONITOR_GITHUB_REPO=Tashima-Tarsh/Zero-Trust-Fintech
DISHA_MONITOR_GITHUB_TOKEN=
# Select DISHA's real Railway project, NOT an unrelated project.
DISHA_MONITOR_RAILWAY_TOKEN=
DISHA_MONITOR_RAILWAY_PROJECT_ID=
DISHA_MONITOR_RAILWAY_SERVICE_ID=
DISHA_MONITOR_RAILWAY_ENVIRONMENT_ID=
# Cloudflare Zone Analytics: read-only Zone Analytics/GraphQL permission.
DISHA_MONITOR_CLOUDFLARE_TOKEN=
DISHA_MONITOR_CLOUDFLARE_ZONE_ID=
# n8n HTTPS origin; optional API key adds actual workflow execution monitoring.
DISHA_MONITOR_N8N_URL=
DISHA_MONITOR_N8N_API_KEY=
