{
  "name": "Fraud Alert Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fraud-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Fraud Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "const alert = items[0].json.data;\n\n// Format fraud report\nreturn [{\n  json: {\n    alert_type: 'FRAUD_REJECTED',\n    device_id: alert.payload ? alert.payload.device_id : 'unknown',\n    utr: alert.payload ? alert.payload.utr : 'unknown',\n    amount: alert.payload ? alert.payload.amount : 0,\n    fraud_score: alert.fraud_report ? alert.fraud_report.overall_score : 0,\n    flags: alert.fraud_report ? alert.fraud_report.flags : [],\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Format Alert",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"alert_logged\", \"flags\": {{$json.flags}}}"
      },
      "name": "Respond to Fraud Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Fraud Webhook": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Respond to Fraud Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
