{
  "name": "Payment Verification - Production",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payment-verification",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Validate incoming payment data\nconst data = items[0].json.data;\n\nif (!data.block_hash || !data.payload || data.fraud_score === undefined) {\n  throw new Error('Invalid payment data');\n}\n\n// Log for audit\nconsole.log('Processing payment:', data.block_hash);\n\nreturn [{\n  json: {\n    block_hash: data.block_hash,\n    amount: data.payload.amount,\n    utr: data.payload.utr,\n    merchant_id: data.payload.merchant_id,\n    fraud_score: data.fraud_score,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Validate Payment",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"fraud_score\"]}}",
              "operation": "smaller",
              "value2": 80
            }
          ]
        }
      },
      "name": "Check Fraud Score",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{$env.BANK_SETTLEMENT_API}}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.BANK_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "utr",
              "value": "={{$json[\"utr\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            },
            {
              "name": "merchant_id",
              "value": "={{$json[\"merchant_id\"]}}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "name": "Bank Settlement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"settled\", \"block_hash\": \"{{ $json.block_hash }}\"}"
      },
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"rejected\", \"reason\": \"Fraud score too low\", \"fraud_score\": {{ $json.fraud_score }} }",
        "responseCode": 400
      },
      "name": "Reject Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Validate Payment", "type": "main", "index": 0}]]
    },
    "Validate Payment": {
      "main": [[{"node": "Check Fraud Score", "type": "main", "index": 0}]]
    },
    "Check Fraud Score": {
      "main": [
        [{"node": "Bank Settlement", "type": "main", "index": 0}],
        [{"node": "Reject Response", "type": "main", "index": 0}]
      ]
    },
    "Bank Settlement": {
      "main": [[{"node": "Success Response", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
