# =============================================================================
# Zero-Trust Fintech Production Environment Configuration
# =============================================================================

# Database
DATABASE_URL=postgresql://zerotrust:SecurePass123!@localhost:5432/zerotrust_ledger
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SSL=false
REDIS_CHALLENGE_TTL=300
CHALLENGE_TTL_SECONDS=300

# JWT Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# n8n Orchestrator
N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_API_KEY=CHANGE_THIS

# External Services & Bank Rail
BANK_SETTLEMENT_API=https://api.bank.com/settlement
BANK_API_KEY=CHANGE_THIS
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
FCM_SERVER_KEY=CHANGE_THIS

# Security & Freshness Windows
SIGNATURE_MAX_AGE_SECONDS=60
FRESHNESS_WINDOW_SECONDS=120

# Logging & Auditing
LOG_LEVEL=INFO
AUDIT_LOG_PATH=/var/log/zerotrust/audit.log

# Application Lifecycle
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Cloud Options
CLOUD_PROVIDER=
