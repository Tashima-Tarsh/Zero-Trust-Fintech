# Database
DB_USER=zerotrust
DB_PASSWORD=SecurePass123!
DB_NAME=zerotrust_ledger
DATABASE_URL=postgresql://zerotrust:SecurePass123!@localhost:5432/zerotrust_ledger

# Redis
REDIS_URL=redis://localhost:6379/0

# n8n
N8N_PASSWORD=admin123
N8N_API_KEY=your_n8n_api_key_here

# Security
SIGNATURE_MAX_AGE_SECONDS=60
FRESHNESS_WINDOW_SECONDS=120
LOG_LEVEL=INFO

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
