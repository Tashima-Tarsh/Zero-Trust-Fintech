# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=fintech_db
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/fintech_db
DATABASE_POOL_SIZE=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CHALLENGE_TTL=300

# Security Configuration
SIGNATURE_MAX_AGE_SECONDS=60
FRESHNESS_WINDOW_SECONDS=120

# n8n Orchestration Configuration
N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_API_KEY=your_n8n_api_key_here
N8N_PASSWORD=admin_super_secret

# WebSocket Configuration
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
