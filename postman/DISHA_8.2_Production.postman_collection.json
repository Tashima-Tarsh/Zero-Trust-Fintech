    {
      "name": "02. Customer Sovereign Checkout (NPCI Intent)",
      "item": [
        {
          "name": "2.1 Create Dynamic UPI Challenge Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CHECKOUT_URL}}/api/session/new?amount=250.00&desc=Basmati+Rice",
              "host": ["{{CHECKOUT_URL}}"],
              "path": ["api", "session", "new"],
              "query": [
                { "key": "amount", "value": "250.00" },
                { "key": "desc", "value": "Basmati+Rice" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('Dynamic challenge amount generated correctly', function () { pm.expect(res.success).to.be.true; pm.expect(res.challengeAmount).to.be.above(250.00); pm.expect(res.challengeAmount).to.be.below(251.00); pm.expect(res.orderId).to.match(/^Order_/); pm.expect(res.upiLink).to.include('upi://pay?'); });",
                  "if (res.orderId) { pm.environment.set('ORDER_ID', res.orderId); }",
                  "if (res.sessionId) { pm.environment.set('SESSION_ID', res.sessionId); }",
                  "if (res.challengeAmount) { pm.environment.set('CHALLENGE_AMOUNT', String(res.challengeAmount)); }",
                  "const d = new Date();",
                  "const yy = String(d.getFullYear()).slice(-2);",
                  "const mm = String(d.getMonth() + 1).padStart(2, '0');",
                  "const dd = String(d.getDate()).padStart(2, '0');",
                  "const hh = String(d.getHours()).padStart(2, '0');",
                  "const min = String(d.getMinutes()).padStart(2, '0');",
                  "const ss = String(d.getSeconds()).padStart(2, '0');",
                  "pm.environment.set('DYNAMIC_UTR', yy + mm + dd + hh + min + ss);",
                  "pm.environment.set('TIMESTAMP', String(Date.now()));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Get Active Session Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CHECKOUT_URL}}/api/session/{{ORDER_ID}}",
              "host": ["{{CHECKOUT_URL}}"],
              "path": ["api", "session", "{{ORDER_ID}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('Session has active countdown', function () { pm.expect(res.success).to.be.true; pm.expect(res.session.status).to.eql('PENDING'); pm.expect(res.session.expiresAt).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
