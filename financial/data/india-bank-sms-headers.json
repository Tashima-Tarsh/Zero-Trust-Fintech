{
  "registry": "DISHA Indian Bank SMS Sender Header Registry",
  "version": "0.2-preliminary",
  "compiled_on": "2026-11-22",
  "scope": "RBI published scheduled commercial bank roster, including nationalized, private, small finance, payments, RRB and foreign institutions in India. Some may be restricted or not actively offer UPI.",
  "classification": "Research data only; sender-only match cannot confirm payment",
  "primary_sources": {
    "rbi_roster": "https://www.rbi.org.in/scripts/bs_viewcontent.aspx?Id=3657",
    "trai_header_information_portal": "https://smsheader.trai.gov.in/",
    "trai_portal_documentation": "https://www.trai.gov.in/portal-and-apps"
  },
  "important_notes": [
    "Bank names from RBI roster; no automatically downloaded TRAI bulk header file was obtained, because the portal timed out.",
    "Headers are from cited bank-authored materials only, not extrapolated from logo, screenshot label or IFSC.",
    "Full sender prefixes such as AD or AX can vary by route; compare registered core header and applicable suffix against TRAI record, not screenshot display labels.",
    "One-way/reply-disabled SMS UI does not by itself establish registered sender ID or debit settlement.",
    "A header lookup does not prove that the bank ledger posted a debit.",
    "RBI roster flags Paytm Payments Bank banking licence as cancelled.",
    "For Axis, bank publications show multiple codes; do not treat them as an exhaustive present-day whitelist until TRAI check."
  ],
